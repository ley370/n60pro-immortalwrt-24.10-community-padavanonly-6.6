# N60 Pro build config for ImmortalWrt 24.10-6.6 (padavanonly community)
# Target: MediaTek Filogic, Netcore N60 Pro (512MB / 128MB)
# Usage: this file is copied to openwrt/.config, then `make defconfig` expands it.
# Packages that are not found in the feeds are dropped automatically by defconfig.

# ---- Target ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# ---- Build options ----
# v10: ccache enabled. The workflow caches ~/.ccache across runs (GitHub
# Actions cache), so a rebuild with only small config changes reuses most
# compiled objects instead of rebuilding everything. First build is still
# slow (cold cache); later rebuilds are much faster.
CONFIG_CCACHE=y
# v11: pin the ccache directory. OpenWrt's rules.mk defaults CCACHE_DIR to
# $(TOPDIR)/.ccache when CONFIG_CCACHE_DIR is unset, which would put the
# cache inside the source tree (/workdir/openwrt/.ccache) instead of the
# ~/.ccache that the workflow caches -- the saved cache would be empty and
# rebuilds would not hit it. This line makes OpenWrt write to the same
# directory the workflow caches.
CONFIG_CCACHE_DIR="/home/runner/.ccache"

# ---- LuCI + Argon theme ----
# Argon 3.x includes its own config; do NOT add the old standalone luci-app-argon-config.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# v10: LuCI base + firewall Chinese packs. Without these, the main menu
# (Status/System/Network/Firewall) stays in English even when the UI
# language is set to zh_cn.
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---- Proxy: PassWall2 + sing-box (v12: replaces PassWall1) ----
# v12 (2026-11-15, user decision 18:17): switch to PassWall2 for
# URLTest/leastPing auto-selection + failover. Old PassWall1 (Socks nesting)
# only fails over in order and does not compare latency.
# PassWall1 lines are REMOVED below, not just disabled: keeping both wastes
# 128MB flash and risks two transparent proxies fighting over DNS/firewall.
# PassWall2 is not in official feeds; diy-part1.sh adds the passwall2 +
# passwall_packages feeds. Its config lives in /etc/config/passwall2 --
# old /etc/config/passwall nodes do NOT migrate automatically; re-add nodes
# in PassWall2 after flashing (subscription link is easiest).
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_sing-box=y
# Basic Core: SingBox only. PassWall2 defaults to "All" on aarch64
# (xray-core + sing-box, each 25-35MB); 128MB flash keeps only sing-box,
# same call as v9 for PassWall1. Xray is not needed: all current nodes are
# sing-box VLESS/Socks.
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# Nftables transparent proxy: default y on firewall4 (25.12). It pulls
# chinadns-ng + dnsmasq-full + nftables + kmod-nft-tproxy/socket/nat.
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# Haproxy: default y on aarch64, but load balancing here is sing-box
# urltest/leastPing, not Haproxy -- disable to save flash.
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# Shadowsocks-Rust: default y on aarch64, pulls the Rust host toolchain
# (the #2 build failure: CI LLVM 404). sing-box already handles SS/SS-2022.
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# SSR / Simple-Obfs / V2ray-Plugin: defaults y, not needed for VLESS nodes.
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# PassWall2 dependencies from the passwall_packages feed (not in official feeds):
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---- Ad blocking: AdGuardHome ----
# Note: luci-i18n-adguardhome-zh-cn is not in the official 25.12 feeds.
# It is listed here so the build picks it up if any feed provides it;
# if not, defconfig drops it and AdGuardHome stays English (usable).
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ---- DNS: AdGuardHome handles filtering; PassWall handles domestic/foreign split ----
# v4: SmartDNS removed. dnsmasq + AdGuardHome + SmartDNS + PassWall was four DNS
# layers in series (extra flash/RAM, DNS loop risk). PassWall already does
# domestic/foreign DNS splitting, so SmartDNS is redundant here.

# ---- VPN: WireGuard (built into Network > Interfaces in 25.12) ----
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# ---- DDNS ----
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---- Upgrade: Attended Sysupgrade (keeps installed packages) ----
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# ---- Traffic stats: nlbwmon ----
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ---- UPnP (auto port forwarding; user requested) ----
# Note: UPnP lets any LAN device open ports automatically. Enable it in
# LuCI under Services > UPnP after flashing. Under double NAT (ONT still
# routing) it only opens ports on the N60, not on the ONT.
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---- Wake on LAN ----
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ---- MTK hardware acceleration: HNAT + WARP + TurboACC-MTK ----
# 2026-11-16 B库失败整改，参考 padavanonly 自家 mt7986-nowifi.config
# （N60 Pro 是 mt7986a，见 filogic.mk DEVICE_DTS mt7986a-netcore-n60-pro；
# mt7981-nowifi.config 同样如此）：nowifi 配置也全开这套 MTK 闭源加速栈。
# 根因：9999-01-hnat.patch 往 mtk_eth_soc.c 里无条件加了引用 7 个符号
# （HIT_BIND_FORCE_TO_CPU、MTK_FE_*、MTK_WIFI_*）的代码，但定义它们的头文件
# mtk_hnat/nf_hnat_mtk.h 只在 CONFIG_NET_MEDIATEK_HNAT 开启时才 include；
# 原 B 配置没选 kmod-mediatek_hnat，7 符号未声明，target/linux 编译失败。
# 修正：开 HNAT（warp 的前置依赖：warp Makefile DEPENDS +kmod-mediatek_hnat）。
# 注意：“社区版已内置 TurboACC-MTK”是错的——它是 package/mtk/applications/
# luci-app-turboacc-mtk 里的一个包，必须显式选上才编进去，之前没选。
# 风险[待实机验证]：硬件 NAT 卸载会让已卸载的流绕过 nftables/Netfilter，
# 可能使 PassWall2 透明代理、AdGuardHome 对这部分流量失效；刷机后重点测。
# （mt_wifi 见下面“无线”一节：功能在、默认关。）
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_WARP_CHIPSET="mt7986"
CONFIG_WARP_VERSION=2
CONFIG_WARP_NEW_FW=y
# 2026-11-16 借鉴同型号库（hanwckf/Ruijie/routerFW-2410/padavanonly nowifi 均有）：
# WED 硬件接收卸载，与 mt_wifi 直接相关；只加一行，风险低，首编验证。
CONFIG_WED_HW_RRO_SUPPORT=y

# ---- Wireless: mt_wifi (closed-source, fork-native) — function present, default OFF ----
# 2026-11-16 用户要求：无线功能要有，但默认关闭。之前 B 配置里完全没有无线
# （照搬 nowifi 参考配置），只有 99-defaults 的关无线两行是空转——没有驱动，
# radio0/radio1 根本不存在，“默认关”也就无从谈起。
# 参考：padavanonly mt7986-ax6000.config 的无线部分（逐项照搬）。
# 注意：这个 fork 里没有 mt76（package/kernel 下无 mt76），mt_wifi 是唯一无线驱动；
# 它不用 hostapd/wpad，自带 AP 模式（MTK_WIFI_MODE_AP），LuCI 界面走 luci-app-mtwifi-cfg。
# mt_wifi 的依赖 conninfra + HNAT + WARP 上面都已选上。
# SKU/ADIE 取 config.in 默认值 AX6000 / mt7976（N60 Pro 是 mt7986a AX6000 级）。
# 默认关闭靠 files/etc/uci-defaults/99-n60pro-defaults 的
# wireless.radio0.disabled=1 / radio1.disabled=1，mt_wifi 的 LuCI 正是读这两个开关；
# 要开无线时在 LuCI 里把两个 radio 启用并设 SSID/密码即可，不用重刷。
# 风险[待首编验证]：mt_wifi 体积大，且 wifi-profile 里没有 N60 Pro 专属 dat 文件，
# 用的是 mt7986 通用/ax6000 配置，首编须看日志确认驱动能正常编过。
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_MTK_MT_WIFI=m
CONFIG_MTK_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_WIFI_ADIE_TYPE="mt7976"
CONFIG_MTK_WIFI_BASIC_FUNC=y
CONFIG_MTK_WIFI_DRIVER=y
CONFIG_MTK_WIFI_EAP_FEATURE=y
CONFIG_MTK_WIFI_FW_BIN_LOAD=y
CONFIG_MTK_WIFI_MODE_AP=m
CONFIG_MTK_WIFI_MT_MAC=y
CONFIG_MTK_WIFI_SKU_TYPE="AX6000"
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WLAN_HOOK=y
CONFIG_MTK_WLAN_SERVICE=y
CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
CONFIG_MTK_CONNINFRA_APSOC=y
CONFIG_MTK_CONNINFRA_APSOC_MT7986=y
# CONFIG_PACKAGE_luci-app-turboacc is not set
# BBR congestion control (official package; the chenmozhijin BBR_CCA option
# above is replaced by this kernel module).
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- QoS: eqos-mtk (MTK version, from padavanonly nowifi reference) ----
# v4: QoSmate removed. Hardware flow offload bypasses kernel QoS queues, so
# QoSmate is ineffective on accelerated traffic; keeping both QoSmate and eqos
# risks conflicts. eqos stays as the lightweight backup.
# 2026-11-16: 官方 luci-app-eqos 换成 luci-app-eqos-mtk（nowifi 配置所用），
# eqos-mtk 的 LUCI_DEPENDS 带 @!PACKAGE_luci-app-eqos，两者互斥、不能双装。
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y

# ---- IPTV: IGMP proxy + UDP-to-HTTP proxy ----
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_luci-app-igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y

# ---- System monitoring ----
# v4: luci-app-statistics removed (collectd + rrdtool are large and write a
# monitoring DB constantly). nlbwmon already covers per-device traffic stats.
CONFIG_PACKAGE_luci-app-temp-status=y

# ---- USB storage / overlay expansion (must be built in) ----
# N60 Pro has 128MB flash; sing-box + AdGuardHome are large binaries and leave
# little /overlay space. These drivers let a USB 3.0 stick expand /overlay
# later. They must be compiled in now: with a full overlay there is no room
# left to install them afterwards.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# e2fsprogs provides mkfs.ext4, so a FAT32/exFAT USB stick can be formatted
# to ext4 directly on the router via SSH (no need for a Linux PC).
CONFIG_PACKAGE_e2fsprogs=y

# ---- Web terminal ----
CONFIG_PACKAGE_luci-app-ttyd=y

# ---- Device access control ----
CONFIG_PACKAGE_luci-app-accesscontrol=y

# ---- Watchdog: auto-recover on WAN loss ----
CONFIG_PACKAGE_luci-app-watchcat=y
